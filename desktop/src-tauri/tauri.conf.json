{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Tester",
  "version": "0.1.0",
  "identifier": "dev.aitester.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "AI Tester", "width": 1280, "height": 860, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "AI agent that tests websites in a real browser",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../../dist-sidecar/ai-tester-engine/": "ai-tester-engine/" }
  }
}
